<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:detail="clr-namespace:Brows.Detail;assembly=Brows.MBox"
                    xmlns:local="clr-namespace:Brows">
  <Style x:Key="Brows.Style.MBoxProvider.Icon.Line" TargetType="{x:Type Path}">
    <Setter Property="Stroke" Value="{DynamicResource Brows.Theme.MBoxProvider.Icon.Stroke}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Loading">
        <Setter Property="Stroke" Value="{DynamicResource Brows.Theme.MBoxProvider.ReadingForeground}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Brows.Style.MBoxProvider.Icon.StackLine"
         TargetType="{x:Type Path}"
         BasedOn="{StaticResource Brows.Style.MBoxProvider.Icon.Line}">
    <Setter Property="Stroke" Value="{DynamicResource Brows.Theme.MBoxProvider.Icon.StackStroke}"/>
  </Style>
  <DataTemplate x:Key="Brows.Style.MBoxProvider.Icon">
    <Viewbox Width="16" Height="16" Stretch="Uniform">
      <Canvas Width="32" Height="32">
        <Path Style="{StaticResource Brows.Style.MBoxProvider.Icon.StackLine}"
              Data="M 8,7 V 5.5 A 1.5,1.5 0 0 1 9.5,4 H 27.5 A 1.5,1.5 0 0 1 29,5.5
                    V 20.5 A 1.5,1.5 0 0 1 27.5,22 H 26"/>
        <Path Style="{StaticResource Brows.Style.MBoxProvider.Icon.Line}"
              Fill="{DynamicResource Brows.Theme.MBoxProvider.Icon.Fill}"
              Data="M 4.5,9 H 22.5 A 1.5,1.5 0 0 1 24,10.5 V 26.5 A 1.5,1.5 0 0 1 22.5,28
                    H 4.5 A 1.5,1.5 0 0 1 3,26.5 V 10.5 A 1.5,1.5 0 0 1 4.5,9 Z"/>
        <Path Style="{StaticResource Brows.Style.MBoxProvider.Icon.Line}"
              Data="M 4,10.5 L 13.5,18 L 23,10.5"/>
      </Canvas>
    </Viewbox>
  </DataTemplate>
  <Style x:Key="Brows.Style.MBoxProvider.ID"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Loading">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.MBoxProvider.ReadingForeground}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Brows.Style.MBoxProvider.Status"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Margin" Value="12 0 0 0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.MBoxProvider.StatusForeground}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Loading">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.MBoxProvider.StatusReadingForeground}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Failed">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.MBoxProvider.StatusErrorForeground}"/>
      </DataTrigger>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Brows.Style.MBoxProvider.Error"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Margin" Value="12 0 0 0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.MBoxProvider.ErrorForeground}"/>
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Brows.Style.MBoxProvider" TargetType="{x:Type local:MBoxProviderControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:MBoxProviderControl}">
          <brows:ProviderGrid Provider="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                              DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              Icon="{Binding ViewModel}"
                              IconTemplate="{StaticResource Brows.Style.MBoxProvider.Icon}"
                              Text="{Binding ViewModel}">
            <brows:ProviderGrid.Resources>
              <DataTemplate x:Key="{x:Type detail:MBoxEntryPreview}">
                <local:MBoxEntryPreviewControl ViewModel="{Binding}"/>
              </DataTemplate>
            </brows:ProviderGrid.Resources>
            <brows:ProviderGrid.TextTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding ID}" Style="{DynamicResource Brows.Style.MBoxProvider.ID}"/>
                  <TextBlock Text="{Binding Status}" Style="{DynamicResource Brows.Style.MBoxProvider.Status}"/>
                  <TextBlock Text="{Binding Error}" Style="{DynamicResource Brows.Style.MBoxProvider.Error}"/>
                </StackPanel>
              </DataTemplate>
            </brows:ProviderGrid.TextTemplate>
          </brows:ProviderGrid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:MBoxProviderControl}" BasedOn="{StaticResource Brows.Style.MBoxProvider}"/>
</ResourceDictionary>
