<UserControl x:Class="Brows.MBoxProviderControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
             xmlns:local="clr-namespace:Brows"
             xmlns:detail="clr-namespace:Brows.Detail;assembly=Brows.MBox">
    <brows:ProviderGrid Provider="{Binding}">
        <brows:ProviderGrid.Resources>
            <DataTemplate x:Key="{x:Type detail:MBoxEntryPreview}">
                <local:MBoxEntryPreviewControl/>
            </DataTemplate>
        </brows:ProviderGrid.Resources>
        <brows:ProviderGrid.Style>
            <Style TargetType="brows:ProviderGrid" BasedOn="{StaticResource Brows.Style.ProviderGrid}">
                <Setter Property="Text" Value="{Binding}"/>
                <Setter Property="TextTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding ID}"/>
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{DynamicResource Brows.Theme.Warning}"/>
                                <TextBlock Text="{Binding Error}"
                                           Foreground="{DynamicResource Brows.Theme.Danger}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </brows:ProviderGrid.Style>
    </brows:ProviderGrid>
</UserControl>
