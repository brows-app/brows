<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:local="clr-namespace:Brows">
  <Style x:Key="Brows.Style.FileSystemStreamGuiControl.Content" TargetType="{x:Type Control}">
    <Style.Resources>
      <ControlTemplate x:Key="Brows.Style.FileSystemStreamGuiControl.Text" TargetType="{x:Type Control}">
        <brows:EntryStreamTextControl ViewModel="{Binding}"/>
      </ControlTemplate>
      <ControlTemplate x:Key="Brows.Style.FileSystemStreamGuiControl.Image" TargetType="{x:Type Control}">
        <local:FileSystemStreamGuiImage ViewModel="{Binding}"/>
      </ControlTemplate>
      <ControlTemplate x:Key="Brows.Style.FileSystemStreamGuiControl.Media" TargetType="{x:Type Control}">
        <brows:EntryStreamMediaControl ViewModel="{Binding}"/>
      </ControlTemplate>
      <ControlTemplate x:Key="Brows.Style.FileSystemStreamGuiControl.Preview" TargetType="{x:Type Control}">
        <brows:EntryStreamPreviewControl ViewModel="{Binding}"/>
      </ControlTemplate>
    </Style.Resources>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template" Value="{x:Null}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding ForceText}" Value="True">
        <Setter Property="Template" Value="{StaticResource Brows.Style.FileSystemStreamGuiControl.Text}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ForceImage}" Value="True">
        <Setter Property="Template" Value="{StaticResource Brows.Style.FileSystemStreamGuiControl.Image}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ForceMedia}" Value="True">
        <Setter Property="Template" Value="{StaticResource Brows.Style.FileSystemStreamGuiControl.Media}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ForcePreview}" Value="True">
        <Setter Property="Template" Value="{StaticResource Brows.Style.FileSystemStreamGuiControl.Preview}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ForceMarkdown}" Value="True">
        <Setter Property="Template" Value="{DynamicResource Brows.Style.EntryStreamMarkdownControl.Preview}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Force}" Value="False">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Control}">
              <Grid>
                <Control Template="{StaticResource Brows.Style.FileSystemStreamGuiControl.Text}"/>
                <Control>
                  <Control.Style>
                    <Style TargetType="{x:Type Control}">
                      <Setter Property="Template" Value="{x:Null}"/>
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding State.Text.Changed}" Value="True"/>
                            <Condition Binding="{Binding State.Text.Loading}" Value="False"/>
                            <Condition Binding="{Binding State.Text.Success}" Value="False"/>
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Template"
                                  Value="{StaticResource Brows.Style.FileSystemStreamGuiControl.Preview}"/>
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Control.Style>
                </Control>
                <Control>
                  <Control.Style>
                    <Style TargetType="{x:Type Control}">
                      <Setter Property="Template" Value="{x:Null}"/>
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding State.Preview.Changed}" Value="True"/>
                            <Condition Binding="{Binding State.Preview.Loading}" Value="False"/>
                            <Condition Binding="{Binding State.Preview.Success}" Value="False"/>
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Template"
                                  Value="{StaticResource Brows.Style.FileSystemStreamGuiControl.Image}"/>
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Control.Style>
                </Control>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Brows.Style.FileSystemStreamGuiControl" TargetType="{x:Type local:FileSystemStreamGuiControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FileSystemStreamGuiControl}">
          <Control DataContext="{TemplateBinding ViewModel}"
                   Style="{StaticResource Brows.Style.FileSystemStreamGuiControl.Content}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:FileSystemStreamGuiControl}"
         BasedOn="{StaticResource Brows.Style.FileSystemStreamGuiControl}"/>
</ResourceDictionary>
