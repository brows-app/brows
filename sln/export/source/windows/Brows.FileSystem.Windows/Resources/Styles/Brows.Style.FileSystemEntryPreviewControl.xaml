<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows">
  <Style x:Key="Brows.Style.FileSystemEntryPreviewControl" TargetType="{x:Type local:FileSystemEntryPreviewControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FileSystemEntryPreviewControl}">
          <local:FileSystemStreamGuiControl
            ViewModel="{Binding ViewModel.Provider.Observation.Current.Stream,
                                RelativeSource={RelativeSource TemplatedParent}}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:FileSystemEntryPreviewControl}"
         BasedOn="{StaticResource Brows.Style.FileSystemEntryPreviewControl}"/>
</ResourceDictionary>
