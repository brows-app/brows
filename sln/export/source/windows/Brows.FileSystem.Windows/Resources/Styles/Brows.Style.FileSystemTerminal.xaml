<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:tty="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:local="clr-namespace:Brows"
                    xmlns:gui="clr-namespace:Brows.Gui;assembly=Brows.Framework.Windows"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Brows.Style.FileSystemTerminal.Status" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.FileSystemTerminal.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.FileSystemTerminal.FontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.FileSystemTerminal.Foreground}"/>
    <Setter Property="Margin" Value="4,2"/>
  </Style>
  <Style x:Key="Brows.Style.FileSystemTerminal.Terminal" TargetType="{x:Type tty:TerminalEmulator}">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="AutoStart" Value="False"/>
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.FileSystemTerminal.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.FileSystemTerminal.FontSize}"/>
  </Style>
  <Style x:Key="Brows.Style.FileSystemTerminal" TargetType="{x:Type local:FileSystemTerminalControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FileSystemTerminalControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PART_Status" Grid.Row="0"
                       Style="{StaticResource Brows.Style.FileSystemTerminal.Status}"/>
            <tty:TerminalEmulator x:Name="PART_Terminal" Grid.Row="1" AutoStart="False"
                                  gui:InputOwner.Owner="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource Brows.Style.FileSystemTerminal.Terminal}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:FileSystemTerminalControl}"
         BasedOn="{StaticResource Brows.Style.FileSystemTerminal}"/>
</ResourceDictionary>