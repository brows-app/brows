<brows:ModelView x:Class="Brows.FileSystemProviderControl"
                 x:ClassModifier="internal"
                 x:TypeArguments="_:FileSystemProvider"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Brows"
                 xmlns:detail="clr-namespace:Brows.Detail;assembly=Brows.FileSystem"
                 xmlns:_="clr-namespace:Brows;assembly=Brows.FileSystem">
  <Control.Template>
    <ControlTemplate>
      <brows:ProviderGrid Provider="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                          DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <brows:ProviderGrid.Resources>
          <DataTemplate x:Key="{x:Type detail:FileSystemEntryPreview}">
            <local:FileSystemEntryPreviewControl/>
          </DataTemplate>
          <DataTemplate x:Key="{x:Type detail:FileSystemTerminal}">
            <local:FileSystemTerminalControl ViewModel="{Binding}"/>
          </DataTemplate>
        </brows:ProviderGrid.Resources>
        <brows:ProviderGrid.Style>
          <Style TargetType="brows:ProviderGrid" BasedOn="{StaticResource Brows.Style.ProviderGrid}">
            <Setter Property="Icon" Value="{Binding ViewModel}"/>
            <Setter Property="IconTemplate">
              <Setter.Value>
                <DataTemplate>
                  <Grid>
                    <brows:EntryIconControl ViewModel="{Binding Entry[Icon]}"/>
                    <brows:EntryIconControl ViewModel="{Binding Entry[Overlay]}"/>
                  </Grid>
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="Text" Value="{Binding ViewModel}"/>
            <Setter Property="TextTemplate">
              <Setter.Value>
                <DataTemplate>
                  <brows:EntryDataControl ViewModel="{Binding Entry[Path]}"/>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </brows:ProviderGrid.Style>
      </brows:ProviderGrid>
    </ControlTemplate>
  </Control.Template>
</brows:ModelView>
