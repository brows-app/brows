<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Brows.Style.Git.Entry.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.Monospace}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.Monospace.Size}" />
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.Monospace.Weight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Entry.Row.IsIgnored}" Value="True" />
          <Condition Binding="{Binding Entry.Row.Index}" Value="" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Opacity" Value="0.55" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding Entry.Row.IsConflict}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Danger}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding AccessingFlag}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Warning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding AccessError}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Danger}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style
          x:Key="Brows.Style.Git.Provider.Summary"
          TargetType="TextBlock"
          BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Warning}" />
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.Monospace}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.Monospace.Size}" />
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.Monospace.Weight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status.Operation}" Value="{x:Null}">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status.Operation}" Value="">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status.HasConflicts}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Danger}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status.Summary}" Value="Working tree clean">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Success}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status.IsBare}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Info}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Brows.Style.Git.Provider.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.Monospace}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.Monospace.Size}" />
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.Monospace.Weight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
