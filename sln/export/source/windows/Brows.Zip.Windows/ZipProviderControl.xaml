<brows:ModelView x:Class="Brows.ZipProviderControl"
                 x:ClassModifier="internal"
                 x:TypeArguments="_:ZipProvider"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Brows"
                 xmlns:detail="clr-namespace:Brows.Detail;assembly=Brows.Zip"
                 xmlns:_="clr-namespace:Brows;assembly=Brows.Zip">
  <Control.Template>
    <ControlTemplate>
      <brows:ProviderGrid Provider="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                          DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <brows:ProviderGrid.Resources>
          <DataTemplate x:Key="{x:Type detail:ZipEntryPreview}">
            <local:ZipEntryPreviewControl/>
          </DataTemplate>
        </brows:ProviderGrid.Resources>
        <brows:ProviderGrid.Style>
          <Style TargetType="brows:ProviderGrid" BasedOn="{StaticResource Brows.Style.ProviderGrid}">
            <Setter Property="Icon" Value="{Binding ViewModel.Icon}"/>
            <Setter Property="IconTemplate">
              <Setter.Value>
                <DataTemplate>
                  <brows:EntryIconImage Source="{Binding}"/>
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="Text" Value="{Binding ViewModel.ID}"/>
            <Setter Property="TextTemplate">
              <Setter.Value>
                <DataTemplate>
                  <brows:EntryDataTextBlock Text="{Binding}"/>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </brows:ProviderGrid.Style>
      </brows:ProviderGrid>
    </ControlTemplate>
  </Control.Template>
</brows:ModelView>
