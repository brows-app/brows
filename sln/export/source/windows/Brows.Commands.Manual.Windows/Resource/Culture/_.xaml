    <Border/>
    <notices:LibGit2Notice/>
    <Border/>
    <notices:LibSsh2Notice/>
    <Border/>
    <notices:ConPtyNotice/>
    <Border/>
    <notices:MarkdigNotice/>
    <Border/>
