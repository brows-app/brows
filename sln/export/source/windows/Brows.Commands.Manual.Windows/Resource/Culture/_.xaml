<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:licenses="clr-namespace:Brows.Licenses"
                    xmlns:notices="clr-namespace:Brows.Notices">
  <CompositeCollection x:Key="Manual_TextCollection">
    <TextBlock>
            <Run Text="Brows" FontWeight="{DynamicResource Brows.Font.Weight.Bold}"/>
            <Run Text="is a file manager for power users."/>
    </TextBlock>
    <TextBlock>
            <Run Text="Control+N" Style="{DynamicResource Brows.Style.KeyboardKey}"/>
            <Run Text="opens a new panel."/>
    </TextBlock>
    <TextBlock>
            <Run Text="Tab" Style="{DynamicResource Brows.Style.KeyboardKey}"/>
            <Run Text="cycles through panels."/>
    </TextBlock>
    <TextBlock>
            <Run Text="Control+L" Style="{DynamicResource Brows.Style.KeyboardKey}"/>
            <Run Text="launches the command palette. From there, type commands or paths to navigate the file system."/>
    </TextBlock>
    <Border/>
    <notices:BrowsNotice/>
    <Border/>
    <TextBlock FontWeight="{DynamicResource Brows.Font.Weight.Bold}">THIRD-PARTY SOFTWARE NOTICES</TextBlock>
    <TextBlock/>
    <TextBlock>
      Brows includes software developed by third parties. The notices and licenses for that software
      follow. Each component remains the property of its copyright holders and is distributed under its
      own license terms.
    </TextBlock>
