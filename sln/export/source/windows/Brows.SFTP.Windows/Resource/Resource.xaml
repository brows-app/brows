<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows">
  <DataTemplate x:Key="SftpEntry_Name">
    <brows:EntryNameGrid Text="{Binding Item[Name]}" Icon="{Binding Item[Icon]}"/>
  </DataTemplate>

  <DataTemplate x:Key="SftpConnectionEntry_Kind">
    <brows:EntryDataControl ViewModel="{Binding Item[Kind]}"/>
  </DataTemplate>

  <DataTemplate x:Key="SftpConnectionEntry_Data">
    <TextBlock DataContext="{Binding Item[Data]}" TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Ready}" Value="True">
              <Setter Property="Text" Value="{Binding Display}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </DataTemplate>

  <DataTemplate x:Key="PanelProvider_SftpProvider">
    <local:SftpProviderControl ViewModel="{Binding}"/>
  </DataTemplate>

  <DataTemplate x:Key="PanelProvider_SftpConnectionProvider">
    <local:SftpConnectionProviderControl ViewModel="{Binding}"/>
  </DataTemplate>
</ResourceDictionary>
