<brows:ModelView x:Class="Brows.FtpProviderControl"
                 x:ClassModifier="internal"
                 x:TypeArguments="_:FtpProvider"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Brows"
                 xmlns:detail="clr-namespace:Brows.Detail;assembly=Brows.FTP.Client"
                 xmlns:_="clr-namespace:Brows;assembly=Brows.FTP">
  <Control.Template>
    <ControlTemplate>
      <brows:ProviderGrid Provider="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                          DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <brows:ProviderGrid.Resources>
          <DataTemplate x:Key="{x:Type detail:FtpEntryPreview}">
            <ContentControl DataContext="{Binding Provider.Observation.Current.Stream}">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Style.Resources>
                    <ControlTemplate x:Key="TextControl">
                      <Grid>
                        <brows:EntryStreamTextControl ViewModel="{Binding}"/>
                        <brows:EntryStreamViewLoadingControl ViewModel="{Binding}"/>
                        <brows:EntryStreamViewUnavailableControl ViewModel="{Binding}"/>
                      </Grid>
                    </ControlTemplate>
                    <ControlTemplate x:Key="ImageControl">
                      <Grid>
                        <brows:EntryStreamImageControl ViewModel="{Binding}"/>
                        <brows:EntryStreamViewLoadingControl ViewModel="{Binding}"/>
                        <brows:EntryStreamViewUnavailableControl ViewModel="{Binding}"/>
                      </Grid>
                    </ControlTemplate>
                  </Style.Resources>
                  <Setter Property="Template" Value="{x:Null}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ForceText}" Value="True">
                      <Setter Property="Template" Value="{StaticResource TextControl}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ForceImage}" Value="True">
                      <Setter Property="Template" Value="{StaticResource ImageControl}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Force}" Value="False"/>
                        <Condition Binding="{Binding Entry.Kind}" Value="File"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate>
                            <Grid>
                              <Control Template="{StaticResource TextControl}"/>
                              <Control Template="{StaticResource ImageControl}"/>
                            </Grid>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
          </DataTemplate>
        </brows:ProviderGrid.Resources>
        <brows:ProviderGrid.Style>
          <Style TargetType="brows:ProviderGrid" BasedOn="{StaticResource Brows.Style.ProviderGrid}">
            <Setter Property="Icon" Value="{Binding ViewModel.Icon}"/>
            <Setter Property="IconTemplate">
              <Setter.Value>
                <DataTemplate>
                  <brows:EntryIconImage Source="{Binding}"/>
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="Text" Value="{Binding ViewModel.ID}"/>
            <Setter Property="TextTemplate">
              <Setter.Value>
                <DataTemplate>
                  <brows:EntryDataTextBlock Text="{Binding}"/>
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="Content" Value="{Binding ViewModel}"/>
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="{Binding ViewRaw, Converter={x:Static brows:ValueConverter.FallbackIfFalsy}, FallbackValue=0, ConverterParameter=*}"/>
                      <RowDefinition Height="{Binding ViewRaw, Converter={x:Static brows:ValueConverter.FallbackIfFalsy}, FallbackValue=*, ConverterParameter=0}"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                      <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                      </Grid.RowDefinitions>
                      <local:FtpHeadersListView Grid.Row="0" DataContext="{Binding Headers}"/>
                      <local:FtpListingListView Grid.Row="1" DataContext="{Binding Listing}"/>
                    </Grid>
                    <brows:ProviderContent Grid.Row="1" Provider="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </brows:ProviderGrid.Style>
      </brows:ProviderGrid>
    </ControlTemplate>
  </Control.Template>
</brows:ModelView>
