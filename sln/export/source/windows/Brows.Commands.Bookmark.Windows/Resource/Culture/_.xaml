<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:brows="http://schemas.brows.app/xaml"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:commands="clr-namespace:Brows.Commands;assembly=Brows.Framework"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <s:String x:Key="Bookmark_Bookmarks">Bookmarks</s:String>

  <DataTemplate x:Key="CommandContextHint_BookmarkData">
    <StackPanel>
      <Control Template="{DynamicResource CommandContextDataGesture_Hint_Down_Up}"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Enter}"/>
        <TextBlock Text=" to open the selected bookmark."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Remove}"/>
        <TextBlock Text=" to delete the selected bookmark."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Clear}"/>
        <TextBlock Text=" to delete all bookmarks."/>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
