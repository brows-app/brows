<UserControl
        x:Class="Brows.BookmarksControl"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
                Source="/Brows.Commands.Bookmark.Windows;component/Resources/Styles/Brows.Style.Bookmark.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <TextBlock Text="{DynamicResource Bookmark_Bookmarks}" Style="{StaticResource {x:Type TextBlock}}" />
    </Grid>
    <Grid Grid.Row="1">
      <ListView ItemsSource="{Binding Bookmark}" x:Name="ListView">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <TextBlock Text="{Binding Key}" Style="{StaticResource {x:Type TextBlock}}" />
              </Grid>
              <Grid Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Ses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource Brows.Style.Bookmark.Location}" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Brows.Style.Bookmark.Location}" Text="{Binding Loc}" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</UserControl>
