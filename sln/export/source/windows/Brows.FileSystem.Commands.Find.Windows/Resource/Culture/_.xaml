<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:commands="clr-namespace:Brows.Commands;assembly=Brows.Framework"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <s:String x:Key="FileSystemFindResult_Error">Error</s:String>
  <s:String x:Key="FileSystemFindResult_Root">Root: </s:String>
  <s:String x:Key="FileSystemFindResult_Status_Searching">Searching</s:String>
  <s:String x:Key="FileSystemFindResult_Status_Completed">Search completed.</s:String>
  <s:String x:Key="FileSystemFindResult_Status_Canceled">Canceled. Partial results may be shown.</s:String>
  <s:String x:Key="FileSystemFindResult_Status_Failed">Failed. Partial results may be shown:</s:String>
  <s:String x:Key="FileSystemFindResult_Status_Truncated">Results were truncated.</s:String>
  <s:String x:Key="FileSystemFindResult_Status_Skipped">Skipped items:</s:String>
  <s:String x:Key="FileSystemFindResult_Status_Errors">Search errors:</s:String>
  <Style
      TargetType="TextBlock"
      x:Key="Brows.Style.Find.TextBlock.MatchMatched"
      BasedOn="{StaticResource Brows.Style.Find.TextBlock}">
    <Setter Property="Text" Value="{Binding MatchMatched, StringFormat='Matched {0} items'}"/>
  </Style>
  <Style
      TargetType="TextBlock"
      x:Key="Brows.Style.Find.TextBlock.MatchTried"
      BasedOn="{StaticResource Brows.Style.Find.TextBlock}">
    <Setter Property="Text" Value="{Binding MatchTried, StringFormat='Checking {0} items'}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Complete}" Value="True">
        <Setter Property="Text" Value="{Binding MatchTried, StringFormat='Checked {0} items'}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style
      TargetType="TextBlock"
      x:Key="Brows.Style.Find.TextBlock.Root"
      BasedOn="{StaticResource Brows.Style.Find.TextBlock}">
    <Setter Property="Text" Value="{Binding Root}"/>
  </Style>
  <Style
      TargetType="TextBlock"
      x:Key="Brows.Style.Find.TextBlock.Status"
      BasedOn="{StaticResource Brows.Style.Find.TextBlock}">
    <Setter Property="Text" Value="{DynamicResource FileSystemFindResult_Status_Searching}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Complete}" Value="True">
        <Setter Property="Text" Value="{DynamicResource FileSystemFindResult_Status_Completed}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Failed}" Value="True">
        <Setter Property="Text" Value="{DynamicResource FileSystemFindResult_Status_Failed}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Canceled}" Value="True">
        <Setter Property="Text" Value="{DynamicResource FileSystemFindResult_Status_Canceled}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style
      TargetType="TextBlock"
      x:Key="Brows.Style.Find.TextBlock.FailedMessage"
      BasedOn="{StaticResource Brows.Style.Find.TextBlock}">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Failed}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style
      TargetType="TextBlock"
      x:Key="Brows.Style.Find.TextBlock.Truncated"
      BasedOn="{StaticResource Brows.Style.Find.TextBlock}">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Truncated}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="StackPanel" x:Key="Brows.Style.Find.Skipped">
    <Setter Property="Visibility" Value="Visible"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding SkippedCount}" Value="0">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="StackPanel" x:Key="Brows.Style.Find.Errors">
    <Setter Property="Visibility" Value="Visible"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding ErrorCount}" Value="0">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="CommandContextHint_FileSystemFindData">
    <StackPanel>
      <Control Template="{DynamicResource CommandContextDataGesture_Hint_Down_Up}"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Enter}"/>
        <TextBlock Text=" to open the found item's location."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Previous}"/>
        <TextBlock Text=" or "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Next}"/>
        <TextBlock Text=" to cycle through the result history."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Remove}"/>
        <TextBlock Text=" to remove this result."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Press "/>
        <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Clear}"/>
        <TextBlock Text=" to remove all completed results."/>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
