<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == ''">$(VCInstallDir)vcpkg\</VcpkgRoot>
  </PropertyGroup>
  <Import
    Project="$(VcpkgRoot)/scripts\buildsystems\msbuild\vcpkg.targets"
    Condition="'$(VcpkgPropsImported)' != 'true'" />
</Project>
