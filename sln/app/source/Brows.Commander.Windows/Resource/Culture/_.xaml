<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:commands="clr-namespace:Brows.Commands;assembly=Brows.Framework"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <ControlTemplate x:Key="CommandContextDataGesture_Hint_Down_Up">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Press "/>
      <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Up}"/>
      <TextBlock Text=" or "/>
      <brows:TriggerPressControl DataContext="{x:Static commands:CommandContextDataGesture.Down}"/>
      <TextBlock Text=" to navigate up or down."/>
    </StackPanel>
  </ControlTemplate>

  <s:String x:Key="Brows.i18n.PanelState.{0} Items">{0} items</s:String>
  <s:String x:Key="Brows.i18n.PanelState.1 Item">1 item</s:String>


  <s:String x:Key="Brows.i18n.PanelState.{0} items selected">{0} items selected</s:String>
  <s:String x:Key="Brows.i18n.PanelState.1 item selected">1 item selected</s:String>

  <s:String x:Key="Brows.i18n.PanelState.{0} items sorting">{0} items sorting</s:String>
  <s:String x:Key="Brows.i18n.PanelState.1 item sorting">1 item sorting</s:String>
</ResourceDictionary>
