<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:_="clr-namespace:Brows.Panels.PanelSecrets">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Brows.Commander.Windows;component/Resources/Styles.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="PanelSecret_SecretPassword">
    <_:SecretPasswordControl ViewModel="{Binding}" />
  </DataTemplate>
  <DataTemplate x:Key="PanelSecret_SecretConfirmPassword">
    <_:SecretConfirmPasswordControl ViewModel="{Binding}" />
  </DataTemplate>
  <DataTemplate x:Key="PanelSecret_SecretUsernameAndPassword">
    <_:SecretUsernameAndPasswordControl ViewModel="{Binding}" />
  </DataTemplate>
</ResourceDictionary>
