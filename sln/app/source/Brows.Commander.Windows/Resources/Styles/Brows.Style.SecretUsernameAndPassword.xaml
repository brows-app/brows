<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:secrets="clr-namespace:Brows.Panels.PanelSecrets">
  <Style x:Key="Brows.Style.SecretUsernameAndPassword" TargetType="secrets:SecretUsernameAndPasswordControl">
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="secrets:SecretUsernameAndPasswordControl">
          <Border DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                  Style="{DynamicResource Brows.Style.PanelSecretControl.Card}">
            <StackPanel>
              <TextBlock Style="{DynamicResource Brows.Style.PanelSecretControl.Prompt}"
                         Text="{Binding ViewModel.Prompt}" />
              <TextBlock Style="{DynamicResource Brows.Style.PanelSecretControl.Label}" Text="Username" />
              <TextBox x:Name="PART_UsernameBox"
                       Style="{DynamicResource Brows.Style.PanelSecretControl.TextBox}" />
              <TextBlock Style="{DynamicResource Brows.Style.PanelSecretControl.Label}" Text="Password" />
              <PasswordBox x:Name="PART_PasswordBox"
                           Style="{DynamicResource Brows.Style.PanelSecretControl.PasswordBox}" />
              <Grid Style="{DynamicResource Brows.Style.PanelSecretControl.Actions}">
                <Button Command="{Binding ViewModel.CancelRequest}"
                        Content="Cancel"
                        Focusable="False"
                        IsCancel="True" />
                <Button Command="{Binding ViewModel.SubmitRequest}"
                        Content="Submit"
                        Focusable="False"
                        IsDefault="True" />
              </Grid>
              <ContentControl ContentTemplate="{DynamicResource Brows.Style.PanelSecretControl.HintTemplate}"
                              Focusable="False" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="secrets:SecretUsernameAndPasswordControl"
         BasedOn="{StaticResource Brows.Style.SecretUsernameAndPassword}" />
</ResourceDictionary>
