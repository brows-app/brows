<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:local="clr-namespace:Brows">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Brows.Commander.Windows;component/Resources/Styles/Brows.Style.CommandPalette.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.CommandSuggestionCollection"
         TargetType="local:CommandSuggestionCollectionControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CommandSuggestionCollectionControl}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <local:CommandSuggestionItemsListView x:Name="PART_Items">
              <local:CommandSuggestionItemsListView.Style>
                <Style
                    TargetType="local:CommandSuggestionItemsListView"
                    BasedOn="{StaticResource Brows.Style.CommandPalette.ListView}">
                  <Setter Property="ItemsSource" Value="{Binding ViewModel.Source}" />
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="IsSynchronizedWithCurrentItem" Value="True" />
                </Style>
              </local:CommandSuggestionItemsListView.Style>
              <local:CommandSuggestionItemsListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <StackPanel.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Background"
                                Value="{DynamicResource Brows.Theme.CommandSuggestionCollection.Background}" />
                        <Setter Property="FontSize"
                                Value="{DynamicResource Brows.Font.CommandSuggestionCollection.FontSize}" />
                        <Setter Property="Foreground">
                          <Setter.Value>
                            <DynamicResource
                                ResourceKey="Brows.Theme.CommandSuggestionCollection.MutedForeground" />
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </StackPanel.Resources>
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="5 0 0 0" />
                      </Style>
                    </StackPanel.Style>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Text" Value="{Binding Help, Mode=OneWay}" />
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="FontFamily"
                                  Value="{DynamicResource Brows.Font.CommandSuggestionCollection.FontFamily}" />
                          <Setter
                              Property="FontSize"
                              Value="{DynamicResource Brows.Font.CommandSuggestionCollection.Suggestion.FontSize}" />
                          <Setter
                              Property="Foreground"
                              Value="{DynamicResource Brows.Theme.CommandSuggestionCollection.Foreground.Opacity90}" />
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Alias, Mode=OneWay}"
                               Visibility="{Binding AliasVisible,
                                                    Converter={x:Static brows:ValueConverter.FallbackIfFalsy},
                                                    ConverterParameter=Visible, FallbackValue=Collapsed}" />
                    <TextBlock Text="{Binding Press, Mode=OneWay}"
                               FontStyle="Italic"
                               Visibility="{Binding PressVisible,
                                                    Converter={x:Static brows:ValueConverter.FallbackIfFalsy},
                                                    ConverterParameter=Visible, FallbackValue=Collapsed}" />
                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                               Visibility="{Binding DescriptionVisible,
                                                    Converter={x:Static brows:ValueConverter.FallbackIfFalsy},
                                                    ConverterParameter=Visible, FallbackValue=Collapsed}" />
                  </StackPanel>
                </DataTemplate>
              </local:CommandSuggestionItemsListView.ItemTemplate>
              <local:CommandSuggestionItemsListView.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                              </Grid.RowDefinitions>
                              <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Name}">
                                  <TextBlock.Style>
                                    <Style
                                        TargetType="TextBlock"
                                        BasedOn="{StaticResource {x:Type TextBlock}}">
                                      <Setter Property="Background" Value="Transparent" />
                                      <Setter Property="FontSize">
                                        <Setter.Value>
                                          <DynamicResource
                                            ResourceKey="Brows.Font.CommandSuggestionCollection.Suggestion.FontSize" />
                                        </Setter.Value>
                                      </Setter>
                                      <Setter Property="FontWeight">
                                        <Setter.Value>
                                          <DynamicResource
                                            ResourceKey="Brows.Font.CommandSuggestionCollection.Group.FontWeight" />
                                        </Setter.Value>
                                      </Setter>
                                      <Setter Property="Foreground">
                                        <Setter.Value>
                                          <DynamicResource
                                            ResourceKey="Brows.Theme.CommandSuggestionCollection.MutedForeground" />
                                        </Setter.Value>
                                      </Setter>
                                      <Setter Property="Padding" Value="5" />
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                              <Grid Grid.Row="1">
                                <ItemsPresenter />
                              </Grid>
                            </Grid>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </local:CommandSuggestionItemsListView.GroupStyle>
            </local:CommandSuggestionItemsListView>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:CommandSuggestionCollectionControl"
         BasedOn="{StaticResource Brows.Style.CommandSuggestionCollection}" />
</ResourceDictionary>
