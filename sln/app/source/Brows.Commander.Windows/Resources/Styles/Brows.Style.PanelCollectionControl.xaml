<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows">
  <Style x:Key="Brows.Style.PanelCollectionControl" TargetType="local:PanelCollectionControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:PanelCollectionControl}">
          <Grid x:Name="PART_Grid" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:PanelCollectionControl"
         BasedOn="{StaticResource Brows.Style.PanelCollectionControl}" />
</ResourceDictionary>
