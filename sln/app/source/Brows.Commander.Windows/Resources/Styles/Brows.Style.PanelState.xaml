<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="clr-namespace:Brows">
  <Style TargetType="brows:PanelStateControl" x:Key="Brows.Style.PanelState">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelState.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelState.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.PanelState.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelState.FontSize}"/>
    <Setter Property="FontStyle" Value="{DynamicResource Brows.Style.PanelState.FontStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type brows:PanelStateControl}">
          <Border DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                  Padding="15 4"
                  Margin="0"
                  Background="{TemplateBinding Background}">
            <Border.Resources>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelState.Foreground}"/>
                <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.PanelState.FontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelState.FontSize}"/>
                <Setter Property="FontStyle" Value="{DynamicResource Brows.Style.PanelState.FontStyle}"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
              </Style>
              <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
              </Style>
            </Border.Resources>
            <Grid>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.ItemsObserved}" Value="False">
                      <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0">
                <Label.Style>
                  <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                    <Setter Property="Content" Value="{Binding ViewModel.ItemsCount}"/>
                    <Setter Property="ContentStringFormat" Value="{DynamicResource 'Brows.i18n.PanelState.{0} Items'}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.ItemsCount}" Value="1">
                        <Setter Property="ContentStringFormat" Value="{DynamicResource 'Brows.i18n.PanelState.1 Item'}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Label.Style>
              </Label>

              <Label Grid.Column="1" Content="|" Margin="5 0"/>

              <Label Grid.Column="2">
                <Label.Style>
                  <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                    <Setter Property="Content" Value="{Binding ViewModel.ItemsSelectedCount}"/>
                    <Setter Property="ContentStringFormat" Value="{DynamicResource 'Brows.i18n.PanelState.{0} items selected'}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.ItemsSelectedCount}" Value="0">
                        <Setter Property="Content" Value="{x:Null}"/>
                        <Setter Property="ContentStringFormat" Value="{x:Null}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ViewModel.ItemsSelectedCount}" Value="1">
                        <Setter Property="ContentStringFormat" Value="{DynamicResource 'Brows.i18n.PanelState.1 item selected'}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Label.Style>
              </Label>

              <Label x:Name="PanelState_ItemsSortingCount" Grid.Column="3">
                <Label.Style>
                  <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                    <Setter Property="Content" Value="{Binding ViewModel.ItemsSortingCount}"/>
                    <Setter Property="ContentStringFormat" Value="{DynamicResource 'Brows.i18n.PanelState.{0} items sorting'}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.ItemsSortingCount}" Value="0">
                        <Setter Property="Content" Value="{x:Null}"/>
                        <Setter Property="ContentStringFormat" Value="{x:Null}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ViewModel.ItemsSortingCount}" Value="1">
                        <Setter Property="ContentStringFormat" Value="{DynamicResource 'Brows.i18n.PanelState.1 item sorting'}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Label.Style>
              </Label>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="brows:PanelStateControl" BasedOn="{StaticResource Brows.Style.PanelState}">
  </Style>
</ResourceDictionary>
