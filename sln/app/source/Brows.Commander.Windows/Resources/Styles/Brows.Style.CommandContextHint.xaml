<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows"
                    xmlns:windows="clr-namespace:Brows.Windows">
  <Style x:Key="Brows.Style.CommandContextHint" TargetType="local:CommandContextHintControl">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.CommandContextHint.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.CommandContextHint.Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CommandContextHintControl}">
          <Border Background="{TemplateBinding Background}"
                  DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                  Padding="{TemplateBinding Padding}">
            <ContentControl Content="{Binding ViewModel}"
                            ContentTemplateSelector="{Binding
                              Item[CommandContextHint],
                              Source={x:Static windows:AppComponent.DataTemplateSelector}}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:CommandContextHintControl"
         BasedOn="{StaticResource Brows.Style.CommandContextHint}" />
</ResourceDictionary>
