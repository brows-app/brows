<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:local="clr-namespace:Brows">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Brows.Commander.Windows;component/Resources/Styles/Brows.Style.OperatorControl.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.CommanderControl" TargetType="local:CommanderControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CommanderControl}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <Border>
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Effect">
                    <Setter.Value>
                      <BlurEffect Radius="5" />
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.DialogFocused}" Value="False">
                      <Setter Property="Effect" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:PanelCollectionControl Grid.Row="0" ViewModel="{Binding ViewModel.Panels}" />
                <brows:OperatorControl
                        Grid.Row="1"
                        Margin="0 4 0 0"
                        MaxHeight="180"
                        Operator="{Binding ViewModel.Operator}"
                        Style="{StaticResource Brows.Style.OperatorControl}"
                        Visibility="{Binding ViewModel.Operator.Operations.Count,
                                     Converter={x:Static brows:ValueConverter.FallbackToCollapsedWithZeroUnset}}" />
              </Grid>
            </Border>
            <Grid>
              <ContentControl DataContext="{Binding ViewModel.Palette}">
                <ContentControl.Style>
                  <Style TargetType="ContentControl">
                    <Setter Property="Content">
                      <Setter.Value>
                        <local:CommandPaletteControl ViewModel="{Binding}" />
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Content" Value="{x:Null}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ContentControl.Style>
              </ContentControl>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:CommanderControl"
         BasedOn="{StaticResource Brows.Style.CommanderControl}" />
</ResourceDictionary>
