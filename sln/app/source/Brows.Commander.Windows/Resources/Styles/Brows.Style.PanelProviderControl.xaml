<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows"
                    xmlns:windows="clr-namespace:Brows.Windows">
  <Style x:Key="Brows.Style.PanelProviderControl" TargetType="local:PanelProviderControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:PanelProviderControl}">
          <ContentControl DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          Content="{Binding ViewModel}"
                          ContentTemplateSelector="{Binding Item[PanelProvider],
                                                Source={x:Static windows:AppComponent.DataTemplateSelector}}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:PanelProviderControl"
         BasedOn="{StaticResource Brows.Style.PanelProviderControl}" />
</ResourceDictionary>
