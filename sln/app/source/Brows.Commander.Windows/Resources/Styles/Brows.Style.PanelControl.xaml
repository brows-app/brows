<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="clr-namespace:Brows">
  <Style x:Key="Brows.Style.PanelControl" TargetType="Control">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="None" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type brows:PanelControl}">
          <Border x:Name="PanelControl_Border"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType=brows:PanelControl}}"
                  Padding="{TemplateBinding Padding}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelControl.Background.Inactive}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ViewModel.Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelControl.Background.Active}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid>
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.Secret}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <brows:PanelProviderControl Grid.Row="0" ViewModel="{Binding ViewModel.Provider}"/>
                <brows:PanelStateControl Grid.Row="1" ViewModel="{Binding ViewModel.State}"/>
              </Grid>

              <Grid>
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.Secret}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <brows:PanelSecretControl ViewModel="{Binding ViewModel.Secret}"/>
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="brows:PanelControl" BasedOn="{StaticResource Brows.Style.PanelControl}">
  </Style>
</ResourceDictionary>
