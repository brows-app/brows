<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Brows.Framework.Windows;component/Resources/Styles/Brows.Style.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.CommanderWindow"
         TargetType="local:CommanderWindow"
         BasedOn="{StaticResource Brows.Style.Window}">
    <Style.Resources>
      <s:String x:Key="Title">Brows</s:String>
    </Style.Resources>
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.CommanderWindow.Background}" />
    <Setter Property="Title"
            Value="{Binding Commander.Panels.Active.Provider.ID, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Content" Value="{Binding Commander, RelativeSource={RelativeSource Self}}" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:CommanderControl ViewModel="{Binding}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Commander.Panels.Active, RelativeSource={RelativeSource Self}}"
                   Value="{x:Null}">
        <Setter Property="Title" Value="{StaticResource Title}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Commander.Panels.Active.Provider.ID,
                                    RelativeSource={RelativeSource Self}}"
                   Value="{x:Null}">
        <Setter Property="Title" Value="{StaticResource Title}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="local:CommanderWindow"
         BasedOn="{StaticResource Brows.Style.CommanderWindow}" />
</ResourceDictionary>
