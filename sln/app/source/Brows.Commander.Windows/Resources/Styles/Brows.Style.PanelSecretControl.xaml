<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="clr-namespace:Brows"
                    xmlns:windows="clr-namespace:Brows.Windows">
  <!--
    Element styles shared by the secret views (password, confirm password, and
    username and password) that PanelSecretControl hosts.
  -->
  <Style x:Key="Brows.Style.PanelSecretControl.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelSecretControl.Card.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.PanelSecretControl.Card.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Brows.Theme.Border.CornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="MaxWidth" Value="440" />
    <Setter Property="Padding" Value="24,20,24,16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Brows.Style.PanelSecretControl.Prompt"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelSecretControl.Prompt.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.PanelSecretControl.Prompt.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Prompt.Foreground}" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Brows.Style.PanelSecretControl.Label"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelSecretControl.Label.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Label.Foreground}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <ControlTemplate x:Key="Brows.Style.PanelSecretControl.Input.Template" TargetType="Control">
    <Border x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{DynamicResource Brows.Theme.TextBox.CornerRadius}"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Border"
                Property="BorderBrush"
                Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.BorderBrush.Focused}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Brows.Style.PanelSecretControl.PasswordBox"
         TargetType="PasswordBox"
         BasedOn="{StaticResource {x:Type PasswordBox}}">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.CaretBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelSecretControl.Input.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.Foreground}" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="SelectionBrush"
            Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.SelectionBrush}" />
    <Setter Property="SelectionOpacity"
            Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.SelectionOpacity}" />
    <Setter Property="Template" Value="{StaticResource Brows.Style.PanelSecretControl.Input.Template}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="Brows.Style.PanelSecretControl.TextBox"
         TargetType="TextBox"
         BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.CaretBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelSecretControl.Input.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.Foreground}" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="SelectionBrush"
            Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.SelectionBrush}" />
    <Setter Property="SelectionOpacity"
            Value="{DynamicResource Brows.Theme.PanelSecretControl.Input.SelectionOpacity}" />
    <Setter Property="Template" Value="{StaticResource Brows.Style.PanelSecretControl.Input.Template}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    Submit and Cancel are reached from the keyboard (Enter and Escape) through
    IsDefault and IsCancel, so their row has no height and the hint shows the keys.
  -->
  <Style x:Key="Brows.Style.PanelSecretControl.Actions" TargetType="Grid">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Height" Value="0" />
  </Style>

  <Style x:Key="Brows.Style.PanelSecretControl.Hint"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.PanelSecretControl.Hint.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Hint.Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="Brows.Style.PanelSecretControl.HintKey" TargetType="Run">
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.PanelSecretControl.HintKey.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.HintKey.Foreground}" />
  </Style>

  <DataTemplate x:Key="Brows.Style.PanelSecretControl.HintTemplate">
    <TextBlock Style="{DynamicResource Brows.Style.PanelSecretControl.Hint}">
      <Run Style="{DynamicResource Brows.Style.PanelSecretControl.HintKey}" Text="Enter" />
      <Run Text="to submit  ·  " />
      <Run Style="{DynamicResource Brows.Style.PanelSecretControl.HintKey}" Text="Esc" />
      <Run Text="to cancel" />
    </TextBlock>
  </DataTemplate>

  <Style x:Key="Brows.Style.PanelSecretControl" TargetType="brows:PanelSecretControl">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.PanelSecretControl.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.PanelSecretControl.Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="brows:PanelSecretControl">
          <Border Background="{TemplateBinding Background}">
            <ContentControl Content="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplateSelector="{Binding
                              Item[PanelSecret],
                              Source={x:Static windows:AppComponent.DataTemplateSelector}}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="brows:PanelSecretControl" BasedOn="{StaticResource Brows.Style.PanelSecretControl}" />
</ResourceDictionary>
