<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows"
                    xmlns:windows="clr-namespace:Brows.Windows">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Brows.Commander.Windows;component/Resources/Styles/Brows.Style.CommandPalette.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.CommandContextDataControl" TargetType="local:CommandContextDataControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CommandContextDataControl}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <Grid.Resources>
              <Style TargetType="ListView" BasedOn="{StaticResource Brows.Style.CommandPalette.ListView}" />
            </Grid.Resources>
            <ContentControl Content="{Binding ViewModel.Current}"
                            ContentTemplateSelector="{Binding Item[CommandContextData],
                                                  Source={x:Static windows:AppComponent.DataTemplateSelector}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:CommandContextDataControl"
         BasedOn="{StaticResource Brows.Style.CommandContextDataControl}" />
</ResourceDictionary>
