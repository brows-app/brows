#
# WARNING: This file will be overwritten when a new version of the application is installed.
# To customize the application's configuration, create a file named ftp.conf in this
# directory's parent that contains only the settings you want to change. This file is
# loaded first, and the settings in that file override the ones here.
#

client[some.host].url = ftp://some.host
client[some.host].credential.password = 1234

# The maximum number of files downloaded at the same time when entries are copied to the file system.
# Brows lowers this automatically when a server refuses additional connections.
StreamSourceConcurrency = 2
