#
# WARNING: This file will be overwritten when a new version of the application is installed.
# To customize the application's configuration, create a file named filesystem.conf in this
# directory's parent that contains only the settings you want to change. This file is
# loaded first, and the settings in that file override the ones here.
#

#
# Configure the program started when the EDIT command is invoked on a file whose extension
# does not have a custom editor, i.e. configure the default editor.
#
#Editor[*] = notepad++.exe

#
# Configure the program started when the EDIT command is invoked on a file with a
# particular extension. For example, if Paint.NET is installed and it should be used
# to edit image files, the configuration below may be used.
#
#Editor[.jpg|.jpeg|.png] = paintdotnet.exe

#
# Specify the CLSID of the preview handler used for a particular extension.
# For example, to preview PDF files with the handler shipped with Microsoft Edge
# (instead of the handler shipped with Adobe Acrobat, if installed), set the following.
#
#Stream.Preview.CLSID[.pdf] = 3A84F9C2-6164-485C-A7D9-4B27F8AC009E

#
# Configure how video and/or audio media is previewed.
#
Stream.Media.SpeedRatio     = 1
Stream.Media.Volume         = 1
Stream.Media.Muted          = true
Stream.Media.AutoplayAudio  = false
Stream.Media.AutoplayVideo  = true
Stream.Media.LoopAudio      = true
Stream.Media.LoopVideo      = true  

#
# Automatically size entry-grid columns to data and available panel space.
# Set AutoFit = false in filesystem.conf to use explicit column widths and Fit.
# Reopen the provider after changing this setting.
#
AutoFit = true
