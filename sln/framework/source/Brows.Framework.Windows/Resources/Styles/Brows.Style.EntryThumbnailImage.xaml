<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entries="clr-namespace:Brows.Entries">
  <Style TargetType="{x:Type Image}" x:Key="Brows.Style.EntryThumbnailImage">
    <Setter Property="Margin" Value="2,0,4,0" />
  </Style>
  <Style x:Key="Brows.Style.EntryThumbnailImageControl" TargetType="entries:EntryThumbnailImage">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="2,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type entries:EntryThumbnailImage}">
          <Image Source="{TemplateBinding Source}"
                 Stretch="{TemplateBinding Stretch}"
                 StretchDirection="{TemplateBinding StretchDirection}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="entries:EntryThumbnailImage"
         BasedOn="{StaticResource Brows.Style.EntryThumbnailImageControl}" />
</ResourceDictionary>
