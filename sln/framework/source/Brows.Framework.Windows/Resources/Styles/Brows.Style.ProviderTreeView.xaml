<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:providers="clr-namespace:Brows.Providers">
  <Style x:Key="Brows.Style.ProviderTreeView" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ProviderTreeView.Foreground}"/>
    <Setter Property="ItemsSource" Value="{Binding Root.Children}"/>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <providers:ProviderTreeNodeLabel ViewModel="{Binding}"/>
        </HierarchicalDataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Brows.Style.ProviderTreeViewControl" TargetType="providers:ProviderTreeView">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type providers:ProviderTreeView}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <providers:ProviderTreeViewItemsTreeView
              x:Name="PART_Tree"
              DataContext="{Binding ViewModel}"
              Style="{StaticResource Brows.Style.ProviderTreeView}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="providers:ProviderTreeView" BasedOn="{StaticResource Brows.Style.ProviderTreeViewControl}"/>
</ResourceDictionary>
