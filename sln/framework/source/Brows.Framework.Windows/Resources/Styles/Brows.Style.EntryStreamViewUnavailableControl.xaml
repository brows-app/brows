<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:trans="clr-namespace:Brows.Localization;assembly=Brows.Framework"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <Style x:Key="Brows.Style.EntryStreamViewUnavailableTextBlock" TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter
        Property="Background"
        Value="Transparent"/>
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.EntryStreamViewUnavailableControl.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.EntryStreamViewUnavailableControl.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.EntryStreamViewUnavailableControl.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.EntryStreamViewUnavailableControl.Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Text"
            Value="{Binding Source={x:Static trans:Translation.Global}, Path=Item[EntryStreamViewUnavailable]}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Brows.Style.EntryStreamViewUnavailableControl" TargetType="local:EntryStreamViewUnavailableControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryStreamViewUnavailableControl}">
          <TextBlock Style="{StaticResource Brows.Style.EntryStreamViewUnavailableTextBlock}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryStreamViewUnavailableControl"
         BasedOn="{StaticResource Brows.Style.EntryStreamViewUnavailableControl}" />
</ResourceDictionary>
