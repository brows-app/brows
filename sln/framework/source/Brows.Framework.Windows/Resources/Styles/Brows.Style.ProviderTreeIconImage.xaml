<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:providers="clr-namespace:Brows.Providers">
  <Style x:Key="Brows.Style.ProviderTreeIconImage" TargetType="{x:Type providers:ProviderTreeIconImage}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type providers:ProviderTreeIconImage}">
          <Image x:Name="PART_Image"
                 Source="{TemplateBinding Source}"
                 Stretch="{TemplateBinding Stretch}"
                 StretchDirection="{TemplateBinding StretchDirection}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="providers:ProviderTreeIconImage" BasedOn="{StaticResource Brows.Style.ProviderTreeIconImage}"/>
</ResourceDictionary>
