<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:entries="clr-namespace:Brows.Entries"
                    xmlns:local="clr-namespace:Brows.Providers"
                    xmlns:data="clr-namespace:Brows.Windows.Data">
  <Style x:Key="Brows.Style.ProviderContent" TargetType="{x:Type local:ProviderContent}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ProviderContent}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition>
                <ColumnDefinition.Style>
                  <Style TargetType="ColumnDefinition">
                    <Setter Property="Width" Value="0.25*"/>
                    <Setter Property="MinWidth" Value="25"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Provider.Navigation}" Value="{x:Null}">
                        <Setter Property="Width" Value="0"/>
                        <Setter Property="MaxWidth" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ColumnDefinition.Style>
              </ColumnDefinition>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <local:ProviderTreeView Grid.Column="0" ViewModel="{Binding Provider.Navigation}"/>
            <GridSplitter
              Grid.Column="1"
              Style="{DynamicResource Brows.Style.ProviderGridSplitter.Column}"
              Visibility="{Binding Provider.Navigation,
                                   Converter={x:Static data:ValueConverter.FallbackIfNull},
                                   ConverterParameter=Visible,
                                   FallbackValue=Collapsed}"/>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition>
                  <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                      <Setter Property="Height" Value="*"/>
                      <Setter Property="MinHeight" Value="25"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Provider.Detail.Active}" Value="{x:Null}">
                          <Setter Property="Height" Value="0"/>
                          <Setter Property="MaxHeight" Value="0"/>
                          <Setter Property="MinHeight" Value="0"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </RowDefinition.Style>
                </RowDefinition>
              </Grid.RowDefinitions>
              <entries:EntryObservationControl Grid.Row="0" ViewModel="{Binding Provider.Observation}"/>
              <GridSplitter
                Grid.Row="1"
                Style="{DynamicResource Brows.Style.ProviderGridSplitter.Row}"
                Visibility="{Binding Provider.Detail.Active,
                                     Converter={x:Static data:ValueConverter.FallbackIfNull},
                                     ConverterParameter=Visible,
                                     FallbackValue=Collapsed}"/>
              <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="4" TextWrapping="Wrap"
                           Text="{Binding Provider.Detail.Error.Message}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Provider.Detail.Error}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ContentControl Grid.Row="1" ContentTemplateSelector="{Binding DetailTemplateSelector}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Content" Value="{Binding Provider.Detail.Active}"/>
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Provider.Detail.Active}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:ProviderContent" BasedOn="{StaticResource Brows.Style.ProviderContent}"/>
</ResourceDictionary>
