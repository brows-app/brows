<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:entries="clr-namespace:Brows.Entries"
                    xmlns:local="clr-namespace:Brows.Providers">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Brows.Style.EntryNameGrid.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.ProviderGrid" TargetType="{x:Type local:ProviderGrid}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ProviderGrid}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                BorderThickness="0 0 0 2.5"
                BorderBrush="{DynamicResource Brows.Theme.ProviderGrid.BorderBrush}">
              <Grid Margin="18 5 0 5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition
                      Width="{DynamicResource Brows.Theme.ProviderGrid.ScrollBar.VerticalScrollBarGridLength}"/>
                </Grid.ColumnDefinitions>
                <entries:EntryNameGrid>
                  <entries:EntryNameGrid.Style>
                    <Style TargetType="entries:EntryNameGrid" BasedOn="{StaticResource Brows.Style.EntryNameGrid}">
                      <Setter Property="Grid.Column" Value="0"/>
                      <Setter Property="Icon"
                              Value="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"/>
                      <Setter Property="IconTemplate"
                              Value="{Binding IconTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                      <Setter Property="Text"
                              Value="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"/>
                      <Setter Property="TextTemplate"
                              Value="{Binding TextTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Style>
                  </entries:EntryNameGrid.Style>
                </entries:EntryNameGrid>
              </Grid>
            </Border>
            <ContentControl x:Name="PART_Content" Grid.Row="1" Focusable="False" IsTabStop="False">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Setter Property="Content"
                          Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                  <Setter Property="ContentTemplate"
                          Value="{Binding ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                 Value="{x:Null}">
                      <Setter Property="Content"
                              Value="{Binding Provider, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                 Value="{x:Null}">
                      <Setter Property="ContentTemplate">
                        <Setter.Value>
                          <DataTemplate>
                            <local:ProviderContent Provider="{Binding}"/>
                          </DataTemplate>
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:ProviderGrid" BasedOn="{StaticResource Brows.Style.ProviderGrid}"/>
</ResourceDictionary>
