<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Brows.Style.EntryIconImage.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.EntryIconControl" TargetType="local:EntryIconControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryIconControl}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <local:EntryIconImage>
              <local:EntryIconImage.Style>
                <Style TargetType="local:EntryIconImage"
                       BasedOn="{StaticResource Brows.Style.EntryIconImageControl}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.Ready}" Value="True">
                      <Setter Property="Source" Value="{Binding ViewModel.Display}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </local:EntryIconImage.Style>
            </local:EntryIconImage>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryIconControl" BasedOn="{StaticResource Brows.Style.EntryIconControl}" />
</ResourceDictionary>
