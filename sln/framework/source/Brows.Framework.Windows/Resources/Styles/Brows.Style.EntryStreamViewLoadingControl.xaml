<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <Style x:Key="Brows.Style.EntryStreamViewLoadingTextBlock" TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter
        Property="Background"
        Value="Transparent"/>
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.EntryStreamViewLoadingControl.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.EntryStreamViewLoadingControl.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Brows.Font.EntryStreamViewLoadingControl.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.EntryStreamViewLoadingControl.Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Text"
            Value="{Binding Text, RelativeSource={RelativeSource AncestorType=local:EntryStreamViewLoadingControl}}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Brows.Style.EntryStreamViewLoadingControl" TargetType="local:EntryStreamViewLoadingControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryStreamViewLoadingControl}">
          <TextBlock Style="{StaticResource Brows.Style.EntryStreamViewLoadingTextBlock}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryStreamViewLoadingControl"
         BasedOn="{StaticResource Brows.Style.EntryStreamViewLoadingControl}" />
</ResourceDictionary>
