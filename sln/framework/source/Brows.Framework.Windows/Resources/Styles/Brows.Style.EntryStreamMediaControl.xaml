<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <Style x:Key="Brows.Style.EntryStreamMediaControl" TargetType="local:EntryStreamMediaControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryStreamMediaControl}">
          <Grid>
            <Viewbox Stretch="Uniform">
              <MediaElement x:Name="PART_MediaElement"
                            UnloadedBehavior="Manual"
                            LoadedBehavior="Manual"
                            IsMuted="True" />
            </Viewbox>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryStreamMediaControl" BasedOn="{StaticResource Brows.Style.EntryStreamMediaControl}" />
</ResourceDictionary>