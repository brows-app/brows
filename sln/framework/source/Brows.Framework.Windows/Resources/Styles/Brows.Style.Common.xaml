<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <Style x:Key="Brows.Style.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.Window.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.Window.Foreground}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
  </Style>
  <Style TargetType="Window" BasedOn="{StaticResource Brows.Style.Window}"/>

  <Style x:Key="Brows.Style.ListBox" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.ListBox.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ListBox.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.ListBox.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  </Style>
  <Style TargetType="ListBox" BasedOn="{StaticResource Brows.Style.ListBox}"/>
  <Style x:Key="Brows.Style.ListView" TargetType="ListView" BasedOn="{StaticResource Brows.Style.ListBox}"/>
  <Style TargetType="ListView" BasedOn="{StaticResource Brows.Style.ListView}"/>

  <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ListBoxItem.Foreground}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="4 2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brows.Theme.ListBoxItem.Background.Hover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brows.Theme.ListBoxItem.Background.SelectionInactive}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="True"/>
          <Condition Property="Selector.IsSelectionActive" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brows.Theme.ListBoxItem.Background.Selection}"/>
      </MultiTrigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.ListBoxItem.BorderBrush.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ListBoxItem.Foreground.Muted}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding View, RelativeSource={RelativeSource AncestorType=ListView}}"
                   Value="{x:Null}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Brows.Style.GridViewColumnHeader" TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.GridViewColumnHeader.Background.Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.GridViewColumnHeader.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.GridViewColumnHeader.BorderBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Brows.Font.GridViewColumnHeader.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Brows.Font.GridViewColumnHeader.FontSize}"/>
    <Setter Property="Padding" Value="6 4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0 0 1 1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <Thumb x:Name="PART_HeaderGripper" Width="5" HorizontalAlignment="Right">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brows.Theme.GridViewColumnHeader.Background.Hover}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.GridViewColumnHeader.BorderBrush.Accent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource Brows.Style.GridViewColumnHeader}"/>

  <Style x:Key="Brows.Style.ProgressBar" TargetType="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.ProgressBar.Background.Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ProgressBar.Foreground.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.ProgressBar.BorderBrush}"/>
    <Setter Property="MinHeight" Value="3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Width" Value="40"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard po:Freeze="True" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                     Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.7"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ProgressBar" BasedOn="{StaticResource Brows.Style.ProgressBar}"/>

  <Style x:Key="Brows.Style.ToolTip" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.ToolTip.Background.Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ToolTip.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.ToolTip.BorderBrush}"/>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource Brows.Style.ToolTip}"/>
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.ContextMenu.Background.Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ContextMenu.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brows.Theme.ContextMenu.BorderBrush}"/>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.MenuItem.Foreground}"/>
  </Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/>
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.Separator.Background.Border}"/>
  </Style>
</ResourceDictionary>
