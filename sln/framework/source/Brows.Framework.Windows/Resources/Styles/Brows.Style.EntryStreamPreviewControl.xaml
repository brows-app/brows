<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <Style x:Key="Brows.Style.EntryStreamPreviewControl" TargetType="local:EntryStreamPreviewControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryStreamPreviewControl}">
          <brows:PreviewHandler x:Name="PART_PreviewHandler" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryStreamPreviewControl"
         BasedOn="{StaticResource Brows.Style.EntryStreamPreviewControl}" />
</ResourceDictionary>