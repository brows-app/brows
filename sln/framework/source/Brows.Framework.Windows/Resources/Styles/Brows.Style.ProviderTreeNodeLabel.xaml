<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:providers="clr-namespace:Brows.Providers">
  <Style
          x:Key="_.Brows.Style.ProviderTreeNodeLabel.Label"
          TargetType="Label"
          BasedOn="{StaticResource {x:Type Label}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brows.Theme.ProviderTreeNodeLabel.Foreground}"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <providers:ProviderTreeIconImage Grid.Column="0" Source="{Binding Icon}"/>
            <ContentPresenter Grid.Column="1" Content="{Binding Name}" />
          </Grid>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Brows.Style.ProviderTreeNodeLabel" TargetType="providers:ProviderTreeNodeLabel">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type providers:ProviderTreeNodeLabel}">
          <Label x:Name="PART_Label"
                 Content="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}"
                 Style="{StaticResource _.Brows.Style.ProviderTreeNodeLabel.Label}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="providers:ProviderTreeNodeLabel" BasedOn="{StaticResource Brows.Style.ProviderTreeNodeLabel}"/>
</ResourceDictionary>
