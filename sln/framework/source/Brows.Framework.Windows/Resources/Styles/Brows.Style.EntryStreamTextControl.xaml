<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:domore="http://schemas.domore.local/winfx/2026/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <Style x:Key="Brows.Style.EntryStreamTextControl" TargetType="local:EntryStreamTextControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryStreamTextControl}">
          <domore:TextReader x:Name="PART_TextReader" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryStreamTextControl" BasedOn="{StaticResource Brows.Style.EntryStreamTextControl}" />
</ResourceDictionary>