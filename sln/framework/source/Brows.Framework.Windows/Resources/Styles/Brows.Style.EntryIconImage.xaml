<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entries="clr-namespace:Brows.Entries">
  <Style TargetType="{x:Type Image}" x:Key="Brows.Style.EntryIconImage">
    <Setter Property="Height" Value="16" />
    <Setter Property="Width" Value="16" />
  </Style>
  <Style x:Key="Brows.Style.EntryIconImageControl" TargetType="entries:EntryIconImage">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type entries:EntryIconImage}">
          <Image Source="{TemplateBinding Source}"
                 Stretch="{TemplateBinding Stretch}"
                 StretchDirection="{TemplateBinding StretchDirection}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="entries:EntryIconImage"
         BasedOn="{StaticResource Brows.Style.EntryIconImageControl}" />
</ResourceDictionary>
