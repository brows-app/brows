<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Brows.Style.Common.xaml" />
    <ResourceDictionary Source="Brows.Style.EntryGridViewColumnHeader.xaml" />
    <ResourceDictionary Source="Brows.Style.EntryListViewItem.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="ListView" x:Key="Brows.Style.EntryListView" BasedOn="{StaticResource Brows.Style.ListView}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10 0 0 0" />
  </Style>
  <Style TargetType="local:EntryListViewItemsListView" BasedOn="{StaticResource Brows.Style.EntryListView}">
    <Setter Property="IsSynchronizedWithCurrentItem" Value="True" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:EntryListViewItem ViewModel="{Binding}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Brows.Style.EntryListViewControl" TargetType="local:EntryListView">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryListView}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <local:EntryListViewItemsListView x:Name="PART_Items" ItemsSource="{Binding ViewModel.Source.Items}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryListView" BasedOn="{StaticResource Brows.Style.EntryListViewControl}" />
</ResourceDictionary>