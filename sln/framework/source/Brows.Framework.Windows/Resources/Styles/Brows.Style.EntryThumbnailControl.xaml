<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Brows.Entries">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Brows.Style.EntryThumbnailImage.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Brows.Style.EntryThumbnailControl" TargetType="local:EntryThumbnailControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EntryThumbnailControl}">
          <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <local:EntryThumbnailImage>
              <local:EntryThumbnailImage.Style>
                <Style TargetType="local:EntryThumbnailImage"
                       BasedOn="{StaticResource Brows.Style.EntryThumbnailImageControl}">
                  <Setter Property="Height" Value="{Binding ViewModel.Definition.ImageHeight}" />
                  <Setter Property="Width" Value="{Binding ViewModel.Definition.ImageWidth}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.Ready}" Value="True">
                      <Setter Property="Source" Value="{Binding ViewModel.Display}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </local:EntryThumbnailImage.Style>
            </local:EntryThumbnailImage>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:EntryThumbnailControl"
         BasedOn="{StaticResource Brows.Style.EntryThumbnailControl}" />
</ResourceDictionary>
