<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="{x:Type GridSplitter}" x:Key="Brows.Style.ProviderGridSplitter">
    <Setter Property="Background" Value="{DynamicResource Brows.Theme.ProviderGridSplitter.Background}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
    <Setter Property="ShowsPreview" Value="True"/>
  </Style>
  <Style
          TargetType="{x:Type GridSplitter}"
          x:Key="Brows.Style.ProviderGridSplitter.Row"
          BasedOn="{StaticResource Brows.Style.ProviderGridSplitter}">
    <Setter Property="ResizeDirection" Value="Rows"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="5"/>
  </Style>
  <Style
          TargetType="{x:Type GridSplitter}"
          x:Key="Brows.Style.ProviderGridSplitter.Column"
          BasedOn="{StaticResource Brows.Style.ProviderGridSplitter}">
    <Setter Property="ResizeDirection" Value="Columns"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Width" Value="5"/>
  </Style>
</ResourceDictionary>
