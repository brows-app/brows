<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:providers="clr-namespace:Brows.Providers">
  <Style x:Key="ProviderTreeViewStyle" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Global_Default_Foreground_Brush}"/>
    <Setter Property="ItemsSource" Value="{Binding Root.Children}"/>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <providers:ProviderTreeNodeLabel Content="{Binding}"/>
        </HierarchicalDataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="providers:ProviderTreeView" BasedOn="{StaticResource ProviderTreeViewStyle}"/>
</ResourceDictionary>
