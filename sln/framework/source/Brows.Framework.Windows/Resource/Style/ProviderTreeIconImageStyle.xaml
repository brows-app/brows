<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:providers="clr-namespace:Brows.Providers">
  <Style TargetType="{x:Type Image}" x:Key="ProviderTreeIconImageStyle">
    <Setter Property="Height" Value="16"/>
    <Setter Property="Width" Value="16"/>
  </Style>
  <Style TargetType="{x:Type providers:ProviderTreeIconImage}" BasedOn="{StaticResource ProviderTreeIconImageStyle}"/>
</ResourceDictionary>
